    <scenes>
        <!--Party-->
        <scene sceneID="Par-004-rap">
            <objects>
                <navigationController id="Par-Nav-001" sceneMemberID="viewController">
                    <tabBarItem key="tabBarItem" title="Party" image="headphones" catalog="system" id="Par-001-rap"/>
